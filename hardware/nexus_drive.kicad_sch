	(text "PWM: 6-PWM mode (TIM1 CHx/CHxN -> INHx/INLx). Set DRV8353S PWM_MODE = 6x over SPI."
		(exclude_from_sim no)
		(at 25.4 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a6c1b9e-c115-4b45-9352-e3fa6d85c24f")
	)
	(text "Each H Bridge sheet = one half-bridge: 2x FDMT80080DC (80 V), 0.5 mOhm low-side shunt, 0.1 uF 100 V local decoupling,"
		(exclude_from_sim no)
		(at 25.4 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2f3a9bcd-cda6-43b6-b14f-eab66bc0cb52")
	)
	(text "Global nets +12V, +3V, GND come from the logic power sheet (teammates). GNDPWR = power ground, V+ = battery bus."
		(exclude_from_sim no)
		(at 25.4 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5a3a806f-6820-4e7f-a95c-672a9ded8e72")
	)
	(text "Gate Driver = TI DRV8353SRTAR (SPI). VDRAIN senses V+; VM is powered from +12V (as on moteus-x1), not from the battery."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "81c41075-00bd-46d1-99e0-aeddadbfe9ef")
	)
	(text "DC-link / bulk capacitance is not in this section (owned by another team member); see README."
		(exclude_from_sim no)
		(at 25.4 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "876dbae4-c8b5-4591-9ee9-0e0a9afc9ace")
	)
	(text "BAT41 low-side gate clamp, Kelvin net ties to SPx/SNx, M2.5 phase output pad."
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87adf257-9b56-42ce-bdb8-e67ef30df339")
	)
	(text "Power stage copied from mjbots moteus-x1 r1 (Apache-2.0): https://github.com/mjbots/moteus/tree/main/hw/x1"
		(exclude_from_sim no)
		(at 25.4 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "91ae0289-bf44-4e78-9c33-baf89d883b1d")
	)
	(text "Current Sense = 22 Ohm + 1 nF RC on each DRV8353 amplifier output -> CURR_A/B/C (DRV SOA/SOB/SOC)."
		(exclude_from_sim no)
		(at 25.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3f4c77d-c668-4e1a-9aa5-2e5c1e7eda69")
	)
	(text "ERC PLACEHOLDERS: PWR_FLAGs mark rails supplied by the logic-power sheet / battery input that is not in this project yet. Delete each flag once its real source (regulator output, connector) is merged in."
