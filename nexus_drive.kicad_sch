	(text "PHASE POWER STAGE"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left bottom)
		)
		(uuid "ddd78150-c368-45c3-adb6-21df1972e881")
	)
	(text "Gate Driver = TI DRV8353SRTAR (SPI). VDRAIN senses V+; VM is powered from +12V (as on moteus-x1), not from the battery."
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "88e9a875-0a0d-434d-9a4c-9668fa4d657c")
	)
	(text "Global nets +12V, +3V, GND come from the logic power sheet (teammates). GNDPWR = power ground, V+ = battery bus."
		(exclude_from_sim no)
		(at 25.4 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "506ee6ab-1639-418f-94e7-ade66a04a9cb")
	)
	(text "Each H Bridge sheet = one half-bridge: 2x FDMT80080DC (80 V), 0.5 mOhm low-side shunt, 0.1 uF 100 V local decoupling,"
		(exclude_from_sim no)
		(at 25.4 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cbd7cede-9197-445d-9187-f856722a1f9b")
	)
	(text "BAT41 low-side gate clamp, Kelvin net ties to SPx/SNx, M2.5 phase output pad."
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63d7a9ad-374f-4a58-a458-a8cc4b8d162c")
	)
	(text "Bulk Capacitance = 36x 4.7 uF 100 V X7R DC-link bank between V+ and GNDPWR."
		(exclude_from_sim no)
		(at 25.4 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6e68802f-b405-474e-9501-3fa87503ccd4")
	)
	(text "Current Sense = 22 Ohm + 1 nF RC on each DRV8353 amplifier output; FCURx go to MCU ADCs. Note: CUR1 = SOC (phase C), CUR3 = SOA (phase A)."
		(exclude_from_sim no)
		(at 25.4 209.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8b450034-15f6-49c7-bfd6-7efcf1b3bbc5")
	)
	(text "MCU side (to be connected): MOTOR1-3 = INHA/B/C (DRV8353 3x PWM mode), MOTOR_HIZ = INLA/B/C tied, MOTOR_ENABLE, DRV8323_* = SPI + nFAULT (moteus net names)."
		(exclude_from_sim no)
		(at 25.4 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5c4e801-71a5-47af-ba3f-5eba460ce4b5")
	)
	(text "Copied from mjbots moteus-x1 r1 (Apache-2.0): https://github.com/mjbots/moteus/tree/main/hw/x1"
		(exclude_from_sim no)
		(at 25.4 217.17000000000002 0)
		(effects
